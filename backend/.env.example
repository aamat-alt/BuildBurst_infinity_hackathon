# PostgreSQL connection string
# Local example:  postgres://postgres:postgres@localhost:5432/novaworks
# Aiven example:  postgres://avnadmin:<password>@<host>:<port>/defaultdb
DATABASE_URL=postgres://postgres:postgres@localhost:5432/novaworks

# Set to true for hosted databases that require SSL (Aiven, Neon, Render...)
DATABASE_SSL=false
# Optional: paste the provider CA certificate instead (use \n for line breaks)
DATABASE_CA_CERT=

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Frontend origin(s) allowed to call the API, comma separated
FRONTEND_URL=http://localhost:5173

PORT=4000
# Set to production when deployed (enables secure cross-site cookies)
NODE_ENV=development

# ---- AI (transcript -> projects) ----
# Set ONE of these. Gemini has a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Year used when the transcript says "20 October" without a year
MEETING_DATE=2026-10-07
